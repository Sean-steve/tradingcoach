# Copy generated local credentials from `bun run local:start`, not from an old hosted project.
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="REPLACE_WITH_LOCAL_PUBLISHABLE_KEY"
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_PUBLISHABLE_KEY="REPLACE_WITH_LOCAL_PUBLISHABLE_KEY"
# Server-only. Never add VITE_ to this name.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_LOCAL_SECRET_KEY"
TRADE_OS_CRON_SECRET="REPLACE_WITH_RANDOM_64_HEX_CHARACTERS"
VITE_ENABLE_GOOGLE_OAUTH="false"

# AI is optional. Without these, coach uses a deterministic offline summary.
# AI_API_BASE_URL="http://127.0.0.1:11434/v1"
# AI_MODEL="qwen3:4b"
# AI_API_KEY=""
# AI_TIMEOUT_MS="30000"
