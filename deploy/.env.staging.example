# Example only. Copy to ignored repository-root .env.staging, chmod 600, fill secrets privately.
NODE_ENV=production
TRADE_OS_DEPLOYMENT_ENV=staging
TRADE_OS_APP_URL=https://staging.your-domain.example
TRADE_OS_RELEASE_SHA=REPLACE_WITH_FULL_40_CHAR_MAIN_SHA
SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
TRADE_OS_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_STAGING_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_STAGING_SERVER_KEY
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_STAGING_PUBLISHABLE_KEY
VITE_ENABLE_GOOGLE_OAUTH=false
TRADE_OS_CRON_SECRET=REPLACE_WITH_UNPREDICTABLE_64_CHARACTER_SECRET
TRADE_OS_WORKER_BATCH_SIZE=2
# AI is disabled by default until consent and private-provider evidence exists.
